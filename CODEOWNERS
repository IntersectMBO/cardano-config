# CODEOWNERS. GitHub applies the LAST matching pattern, and owners do NOT
# accumulate across patterns, so rules are ordered least-specific first and any
# file that needs several owners lists them all on its own line.
#
# Every schema is owned by SRE together with the component's current owner, so a
# schema change notifies both.

# Default maintainer.
* @jasagredo

flake      @IntersectMBO/cardano-node-sre
perSystem  @IntersectMBO/cardano-node-sre
*.nix      @IntersectMBO/cardano-node-sre
flake.lock @IntersectMBO/cardano-node-sre

# Whole directories (the specific rules below override these for individual
# files). The schema and the two default configurations are covered here. Each
# default holds every component's defaults in one document, so no component
# team can own its own file any more. Every team owns both.
defaults/ @IntersectMBO/cardano-node-sre @IntersectMBO/cardano-api-cli-maintainers @IntersectMBO/ouroboros-consensus-maintainers @IntersectMBO/ouroboros-network-maintainers @IntersectMBO/performance-and-tracing
schemas/  @IntersectMBO/cardano-node-sre @IntersectMBO/cardano-api-cli-maintainers @IntersectMBO/ouroboros-consensus-maintainers @IntersectMBO/ouroboros-network-maintainers

