{
    "$id": "https://raw.githubusercontent.com/IntersectMBO/cardano-config/v1/schemas/StorageConfig.schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "StorageConfiguration",
    "properties": {
        "$schema": {
            "default": "https://raw.githubusercontent.com/IntersectMBO/cardano-config/v1/schemas/StorageConfig.schema.json",
            "description": "URL of the JSON Schema this StorageConfig file follows (the $schema annotation), for editors and validators. Pinned to the vN tag of the format version it describes.",
            "title": "$schema",
            "type": "string"
        },
        "DatabasePath": {
            "anyOf": [
                {
                    "format": "path",
                    "title": "String",
                    "type": "string"
                },
                {
                    "description": "SplitDB",
                    "properties": {
                        "ImmutablePath": {
                            "description": "Directory for the immutable database",
                            "format": "path",
                            "title": "ImmutablePath",
                            "type": "string"
                        },
                        "VolatilePath": {
                            "description": "Directory for the volatile database",
                            "format": "path",
                            "title": "VolatilePath",
                            "type": "string"
                        }
                    },
                    "required": [
                        "VolatilePath",
                        "ImmutablePath"
                    ],
                    "title": "Object",
                    "type": "object"
                }
            ],
            "default": "db",
            "description": "Directory (or split directories) where the state is stored",
            "title": "DatabasePath"
        },
        "LedgerDB": {
            "description": "The LedgerDB configuration\nLedgerDB",
            "properties": {
                "Backend": {
                    "anyOf": [
                        {
                            "const": "V2InMemory",
                            "title": "V2InMemory",
                            "type": "string"
                        },
                        {
                            "description": "V2LSM",
                            "properties": {
                                "LSM": {
                                    "description": "LSM-tree backend options\nLSMOptions",
                                    "properties": {
                                        "DatabasePath": {
                                            "description": "Custom path to the LSM database",
                                            "format": "path",
                                            "title": "DatabasePath",
                                            "type": "string"
                                        },
                                        "ExportPath": {
                                            "description": "Directory into which the LSM backend exports snapshots",
                                            "format": "path",
                                            "title": "ExportPath",
                                            "type": "string"
                                        }
                                    },
                                    "title": "LSM",
                                    "type": "object"
                                }
                            },
                            "required": [
                                "LSM"
                            ],
                            "title": "Object",
                            "type": "object"
                        }
                    ],
                    "default": "V2InMemory",
                    "description": "LedgerDB backend: \"V2InMemory\" or an LSM object",
                    "title": "Backend"
                },
                "QueryBatchSize": {
                    "default": 100000,
                    "description": "Chunk size for large backend reads",
                    "maximum": 1.8446744073709551615e19,
                    "minimum": 0,
                    "title": "QueryBatchSize",
                    "type": "integer"
                },
                "Snapshots": {
                    "anyOf": [
                        {
                            "const": "Mithril",
                            "title": "Mithril",
                            "type": "string"
                        },
                        {
                            "description": "SnapshotOptions",
                            "properties": {
                                "MaxDelay": {
                                    "description": "Upper bound (seconds) of the random snapshot delay",
                                    "maximum": 1.8446744073709551615e19,
                                    "minimum": 0,
                                    "title": "MaxDelay",
                                    "type": "integer"
                                },
                                "MinDelay": {
                                    "description": "Lower bound (seconds) of the random snapshot delay",
                                    "maximum": 1.8446744073709551615e19,
                                    "minimum": 0,
                                    "title": "MinDelay",
                                    "type": "integer"
                                },
                                "NumOfDiskSnapshots": {
                                    "description": "How many snapshots to keep on disk",
                                    "maximum": 1.8446744073709551615e19,
                                    "minimum": 0,
                                    "title": "NumOfDiskSnapshots",
                                    "type": "integer"
                                },
                                "RateLimit": {
                                    "description": "Minimum seconds between snapshots",
                                    "maximum": 1.8446744073709551615e19,
                                    "minimum": 0,
                                    "title": "RateLimit",
                                    "type": "integer"
                                },
                                "SlotOffset": {
                                    "description": "Slot at which the snapshot schedule is anchored",
                                    "maximum": 1.8446744073709551615e19,
                                    "minimum": 0,
                                    "title": "SlotOffset",
                                    "type": "integer"
                                },
                                "SnapshotInterval": {
                                    "description": "Slots between snapshots (non-zero)",
                                    "maximum": 1.8446744073709551615e19,
                                    "minimum": 0,
                                    "title": "SnapshotInterval",
                                    "type": "integer"
                                }
                            },
                            "title": "Object",
                            "type": "object"
                        }
                    ],
                    "default": "Mithril",
                    "description": "Snapshot policy: \"Mithril\" or an object of snapshot options",
                    "title": "Snapshots"
                }
            },
            "title": "LedgerDB",
            "type": "object"
        }
    },
    "title": "StorageConfig",
    "type": "object"
}
