-- The index-states
index-state:
  , hackage.haskell.org 2026-08-29T13:20:56Z
  , cardano-haskell-packages 2026-08-21T19:33:33Z

packages:
  .

-- Ensures colourized output from test runners
test-show-details: direct
tests: true

program-options
  ghc-options: -Werror

-- Windows cross with bitvec/simd is broken.
package bitvec
  -- Workaround for windows cross-compilation
  flags: -simd

allow-newer:
  , cborg-json:aeson

if impl(ghc >=9.14)
  allow-newer:
    , serialise:base
    , cborg-json:base
    , cborg:base
    , safe-wild-cards:template-haskell

