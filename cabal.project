repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- The index-states
index-state:
  , hackage.haskell.org 2026-09-02T14:05:07Z
  , cardano-haskell-packages 2026-10-06T16:46:26Z

packages:
  .

-- Ensures colourized output from test runners
test-show-details: direct
tests: True

program-options
  ghc-options: -Werror

-- Windows cross with bitvec/simd is broken.
package bitvec
  -- Workaround for windows cross-compilation
  flags: -simd

if impl(ghc >=9.14)
  allow-newer:
    , serialise:base
    , serialise:containers
    , serialise:time
    , canonical-json:containers
    , cborg-json:base
    , cborg:base
    , cborg:containers
    , dictionary-sharing:containers
    , dependent-map:containers
    , safe-wild-cards:template-haskell

-- Temporary source prerequisites for the CIP-160 ledger draft PR 6153.
-- Remove these overrides after the reviewed package versions reach CHaP.
source-repository-package
  type: git
  location: https://github.com/colll78/cardano-ledger.git
  tag: 71d330f9ffcc0a736c6204d86e45226a0fa64b5a
  --sha256: sha256-4h2rvaAAusvqKuC5TPfkpum6CGGZqW9Le8rJFSWCjvA=
  subdir:
    eras/allegra/impl
    eras/alonzo/impl
    eras/babbage/impl
    eras/byron/crypto
    eras/byron/ledger/impl
    eras/conway/impl
    eras/dijkstra/impl
    eras/mary/impl
    eras/shelley/impl
    libs/cardano-data
    libs/cardano-ledger-api
    libs/cardano-ledger-binary
    libs/cardano-ledger-core
    libs/cardano-protocol
    libs/cardano-protocol-tpraos
    libs/non-integral
    libs/small-steps
    libs/vector-map

source-repository-package
  type: git
  location: https://github.com/colll78/plutus.git
  tag: 9d927c19a756cb15c7eba9e331d1a87878215fd1
  --sha256: sha256-N6bU53Bw3DWF7ymVgLzO0CoKmusbQcbN1+JUFzBh6Qg=
  subdir: plutus-ledger-api

-- Dependency test suites run in their owning repositories. Their test-only
-- bounds need not constrain this consumer's standalone source integration.
package *
  tests: False
  benchmarks: False

package cardano-config
  tests: True
